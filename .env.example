# Copy this file to .env and fill in every value before starting the app.
# The server refuses to start if any required variable below is missing,
# on purpose, a half configured deployment is how secrets end up unset in
# production without anyone noticing until something breaks.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Any standard Postgres connection string. Works with a local Postgres, or a
# managed one (Railway, Render, Supabase, Neon, RDS, etc). If your provider
# requires SSL, also set DATABASE_SSL=true below.
DATABASE_URL="postgresql://user:password@host:5432/dbname"
DATABASE_SSL=false
# Only set true for a self-signed certificate you have verified out of band.
DATABASE_SSL_INSECURE=false

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Random secret used to sign admin session tokens. Generate one with:
#   openssl rand -hex 32
# Never reuse this across deployments, and never commit the real value.
JWT_SECRET=""

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV="production"
PORT=4000
# Only needed if the frontend is hosted on a different origin than this API.
# Leave as is if this server also serves the frontend (the default setup).
CORS_ORIGIN="http://localhost:4000"
# For a standalone client-site embed, set this to the client website origin, e.g. https://www.client.com

# ---------------------------------------------------------------------------
# Brand (this is the entire "white label" surface, nothing else needs editing)
# ---------------------------------------------------------------------------
BRAND_NAME="Velour"
BRAND_ACCENT="#6C5FFF"
BRAND_TAGLINE="Your AI shopping assistant"

# Design defaults. Each of these is only a FALLBACK: whatever the client sets
# in Admin > Branding is stored in brand_config and wins over the value here,
# so a rebrand needs no redeploy. Leave them as-is unless you want a
# particular deployment to start on different defaults.
BRAND_LOGO_URL=""
BRAND_LOGO_DARK_URL=""
BRAND_LOGO_HEIGHT="52"
BRAND_SECONDARY="#171310"
BRAND_BACKGROUND="#F7F3EF"
BRAND_SURFACE="#FFFFFF"
BRAND_TEXT_COLOR="#171310"
BRAND_MUTED_COLOR="#746D68"
BRAND_BORDER_RADIUS="18"
BRAND_FONT_FAMILY="Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
# chat | cart
BRAND_BUBBLE_ICON="chat"
# bottom-right | bottom-left
BRAND_WIDGET_POSITION="bottom-right"
# Set to false for a client who already has their own cart or order tracking.
BRAND_SHOW_CART="true"
BRAND_SHOW_TRACK_ORDERS="true"

# ---------------------------------------------------------------------------
# Shipping and returns (also part of the white label surface, the frontend
# reads these same numbers from GET /api/config, they can never drift from
# what checkout actually charges)
# ---------------------------------------------------------------------------
# Both in paise. Free shipping at or above the threshold, flat fee below it.
SHIPPING_FREE_THRESHOLD=199900
SHIPPING_FLAT_FEE=9900
# How many days after delivery a customer can still start a return.
RETURN_WINDOW_DAYS=14
# Starter stock quantity given to every new variant (seeded or created from
# the admin dashboard). A placeholder so new products are sellable
# immediately, not a real inventory count, adjust actual numbers from the
# admin Inventory tab.
DEFAULT_VARIANT_STOCK=20

# ---------------------------------------------------------------------------
# Transactional email. Set EMAIL_PROVIDER=resend for production. Leave blank only for local development.
# ---------------------------------------------------------------------------
# resend | console (console just logs instead of sending, useful for
# local development without a real email account)
EMAIL_PROVIDER=""
# https://resend.com -> API Keys (only needed if EMAIL_PROVIDER=resend)
EMAIL_API_KEY=""
EMAIL_FROM_ADDRESS="orders@yourdomain.com"

# ---------------------------------------------------------------------------
# Razorpay (https://dashboard.razorpay.com -> Settings -> API Keys)
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Settings -> Webhooks -> add an endpoint at https://yourdomain.com/api/payments/razorpay/webhook
# subscribed to payment.captured, payment.failed, and order.paid, then copy its secret here.
RAZORPAY_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# AI. No provider is hardcoded; deepseek is the default, with openai and anthropic also supported.
# ---------------------------------------------------------------------------
# deepseek | openai | anthropic | gemini | groq
# All five support tool calling, which the agent requires.
AI_PROVIDER="gemini"
# https://platform.deepseek.com -> API Keys (for AI_PROVIDER=deepseek)
# https://platform.openai.com -> API Keys (for AI_PROVIDER=openai)
# https://console.anthropic.com -> API Keys (for AI_PROVIDER=anthropic)
AI_API_KEY=""
# Leave blank to use that provider's default model (current defaults are
# provider-specific and overridable here). Set explicitly to use a different model with the same
# provider, no code changes needed either way.
AI_MODEL=""
# How long to wait for a reply before giving up on this provider, in
# milliseconds. On timeout, a 429, or an upstream 5xx, the fallback below
# is tried once if one is configured. A bad API key or a genuine 400 is
# never retried against the fallback, that would just hide a
# configuration mistake.
AI_TIMEOUT_MS="30000"
# Optional. Leave all three blank to run with no fallback.
AI_FALLBACK_PROVIDER=""
AI_FALLBACK_API_KEY=""
AI_FALLBACK_MODEL=""

# Vision, used only to score return photos. Configured separately because
# the cheap text models cannot see images: groq's gpt-oss-20b and every
# deepseek model have no image input at all. Use gemini, openai, or
# anthropic here. Leave blank to skip photo scoring entirely.
AI_VISION_PROVIDER=""
AI_VISION_API_KEY=""
AI_VISION_MODEL=""

# ---------------------------------------------------------------------------
# Photo storage for return/refund/damaged-item uploads
# Works with real AWS S3, or any S3-compatible provider (Cloudflare R2,
# Backblaze B2, DigitalOcean Spaces, MinIO). For real AWS S3, leave
# S3_ENDPOINT blank. For everything else, set it to that provider's endpoint.
# ---------------------------------------------------------------------------
S3_BUCKET=""
S3_REGION="ap-south-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
# The base URL photos are served from. For real AWS S3 with a public bucket,
# leave blank, it is derived automatically. For R2/Spaces/MinIO or a bucket
# behind a CDN, set this to that public base URL.
S3_PUBLIC_BASE_URL=""

# ---------------------------------------------------------------------------
# One-time use: only read by `npm run seed`, not by the running server.
# Sets the first admin login. Change the password after first login is not
# supported yet in the UI, if you need to change it, hash a new password
# with bcryptjs and update the admin_users row directly, or re-run seed with
# a new ADMIN_EMAIL.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Pending-payment inventory reservation lifetime
INVENTORY_RESERVATION_MINUTES=20

# ---------------------------------------------------------------------------
# Widget theme (all optional)
# ---------------------------------------------------------------------------
# Layer 2 of four: these override the built-in defaults, and are themselves
# overridden by the Widget theme page in the dashboard, then by data-*
# attributes on the embed script tag. Leaving one unset is not the same as
# setting it blank: unset means the layer below decides.
#
# QUOTE THE COLOURS. dotenv reads an unquoted leading # as a comment, so
# SAHAAY_ACCENT=#0E7C66 silently becomes empty. Either quote it or drop the
# hash; both of the forms below work.
SAHAAY_ACCENT="#6C5FFF"
# SAHAAY_ACCENT=6C5FFF
SAHAAY_ACCENT_INK="#FDFDFD"
SAHAAY_BG="#FFFFFF"
SAHAAY_TINT_FROM="#FFFFFF"
SAHAAY_TINT_TO="#F4F2FF"
SAHAAY_INK="#1A1A1A"

# Pixels, no unit.
SAHAAY_RADIUS_SHELL=24
SAHAAY_RADIUS_CARD=16

# Family names only, never a url(). A Google Font works if the host page
# already loads it; the widget will not fetch one for you.
SAHAAY_FONT="Inter, ui-sans-serif, system-ui, sans-serif"

# floating (pills over the content) or solid (a filled bar).
SAHAAY_HEADER_STYLE=floating
# comfortable or compact.
SAHAAY_DENSITY=comfortable

# Replaces the wordmark in the empty state. http or https only. Blank falls
# back to BRAND_NAME as text.
SAHAAY_LOGO_URL=
SAHAAY_GREETING=

# A JSON array of 3 to 5 starter questions. Anything else is ignored and the
# widget falls back to the dashboard's suggested questions.
SAHAAY_SUGGESTIONS='["Do you have this in my size?","Where is my order?","What is the return window?"]'
